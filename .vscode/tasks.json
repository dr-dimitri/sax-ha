{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Home Assistant: run test config",
      "type": "shell",
      "command": "hass -c config",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Tests: pytest",
      "type": "shell",
      "command": "pytest -v",
      "problemMatcher": []
    },
    {
      "label": "Lint: ruff",
      "type": "shell",
      "command": "ruff check custom_components tests",
      "problemMatcher": []
    },
    {
      "label": "Format: black",
      "type": "shell",
      "command": "black custom_components tests",
      "problemMatcher": []
    }
  ]
}
