  "issues": {
    "extended_mode_unavailable": {
      "title": "SAX SunSpec mode unreachable",
      "description": "The SunSpec mode register block (slave ID {slave_id}) of the SAX storage system is unreachable. Sensors that depend on it (storage detail values, grid/smart meter values, battery values) show \"unknown\" until the connection is restored. Basic Mode sensors (state of charge, switch, power limits) are not affected. Please check whether the configured slave ID (SunSpec mode, default: 100) is correct and whether the device runs firmware combination Master V61/Gateway V54 or newer."
    }
